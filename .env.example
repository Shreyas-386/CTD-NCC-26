# 1. Base URL for REST API calls (Axios requests)
# - Local Dev Default: http://localhost:3000/api
# - Vercel Production: https://your-deployed-node-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3000/api

# 2. Base Backend URL (Server-Sent Events / SSE execution streams)
# - Local Dev Default: http://localhost:3000
# - Vercel Production: https://your-deployed-node-backend.onrender.com
VITE_BACKEND_URL=http://localhost:3000
